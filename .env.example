# Google GenAI API key (required for AI summarization and triage)
GOOGLE_GENAI_API_KEY=

# --- Alert data sources -------------------------------------------------------
# Comma-separated list of sources to query. Default: NOAA,USGS
# Valid values: NOAA, USGS, Open511, NBI, FIRMS
ALERT_SOURCES=NOAA,USGS

# Two-letter state codes to cover. Default: MN,WI,MI,IA,IL,ND,SD
ALERT_STATES=MN,WI,MI,IA,IL,ND,SD

# Serve the demo data in src/lib/mock-data.ts instead of calling upstream APIs.
ALERTS_USE_MOCK=false

# Per-request upstream timeout in milliseconds. Default: 15000
ALERT_FETCH_TIMEOUT_MS=15000

# --- NOAA / National Weather Service ------------------------------------------
# No API key. api.weather.gov requires a User-Agent identifying the app and a
# contact address; requests without one are rate-limited or rejected.
NWS_USER_AGENT=InfraGuard (your-contact@example.com)

# --- USGS ---------------------------------------------------------------------
# No configuration. Uses WaterWatch flood stages + NWIS instantaneous values.

# --- Open511 ------------------------------------------------------------------
# Open511 is a specification, not one service: set the base URL of the DOT
# deployment you have access to (the part before /events). Leave blank to
# disable. Some deployments require a key.
OPEN511_BASE_URL=
OPEN511_API_KEY=

# --- NASA FIRMS (active fire detections) --------------------------------------
# Free MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=
# Sensor product. Default: VIIRS_SNPP_NRT
FIRMS_SENSOR=VIIRS_SNPP_NRT
# Lookback window in days. Default: 1
FIRMS_DAYS=1

# --- National Bridge Inventory ------------------------------------------------
# ArcGIS FeatureServer layer URL for NBI data (the layer URL, without /query).
# Field names differ between hosts; adjust NBI_WHERE to match the layer schema.
NBI_FEATURE_SERVER_URL=
NBI_WHERE=BRIDGE_CONDITION = 'P'
